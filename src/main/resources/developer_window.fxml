<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    fx:controller="main.java.controller.DeveloperWindowController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="top-bar">
            <children>
                <Label styleClass="title-label" text="STREAM" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblDeveloper" text="Developer:" />
                <Button onAction="#handleLogout" styleClass="custom-button" text="Logout" />
                <Button onAction="#handleKeluar" styleClass="custom-button" text="Keluar" />
            </children>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Tambah Game">
                    <content>
                        <VBox spacing="12.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <Label styleClass="section-label" text="Game Baru" />
                                <GridPane hgap="10.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Kode Produk:" GridPane.columnIndex="0"
                                            GridPane.rowIndex="0" />
                                        <TextField fx:id="gameKodeField" promptText="Contoh: G013"
                                            GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Judul:" GridPane.columnIndex="0"
                                            GridPane.rowIndex="1" />
                                        <TextField fx:id="gameJudulField" GridPane.columnIndex="1"
                                            GridPane.rowIndex="1" />

                                        <Label text="Harga (Rp):" GridPane.columnIndex="0"
                                            GridPane.rowIndex="2" />
                                        <TextField fx:id="gameHargaField"
                                            promptText="Contoh: 500000" GridPane.columnIndex="1"
                                            GridPane.rowIndex="2" />

                                        <Label text="Genre:" GridPane.columnIndex="0"
                                            GridPane.rowIndex="3" />
                                        <TextField fx:id="gameGenreField" promptText="Contoh: RPG"
                                            GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Ukuran File (GB):" GridPane.columnIndex="0"
                                            GridPane.rowIndex="4" />
                                        <TextField fx:id="gameUkuranField" promptText="Contoh: 40.5"
                                            GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    </children>
                                </GridPane>
                                <Button onAction="#handleSimpanGame" styleClass="custom-button"
                                    text="Simpan Game" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Tambah DLC">
                    <content>
                        <VBox spacing="12.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <Label styleClass="section-label" text="DLC Baru" />
                                <GridPane hgap="10.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Base Game:" GridPane.columnIndex="0"
                                            GridPane.rowIndex="0" />
                                        <ComboBox fx:id="dlcBaseGameCombo" maxWidth="Infinity"
                                            promptText="Pilih salah satu game Anda"
                                            GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Kode Produk:" GridPane.columnIndex="0"
                                            GridPane.rowIndex="1" />
                                        <TextField fx:id="dlcKodeField" promptText="Contoh: DL016"
                                            GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Judul:" GridPane.columnIndex="0"
                                            GridPane.rowIndex="2" />
                                        <TextField fx:id="dlcJudulField" GridPane.columnIndex="1"
                                            GridPane.rowIndex="2" />

                                        <Label text="Harga (Rp):" GridPane.columnIndex="0"
                                            GridPane.rowIndex="3" />
                                        <TextField fx:id="dlcHargaField" promptText="Contoh: 150000"
                                            GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Genre:" GridPane.columnIndex="0"
                                            GridPane.rowIndex="4" />
                                        <TextField fx:id="dlcGenreField" GridPane.columnIndex="1"
                                            GridPane.rowIndex="4" />

                                        <Label text="Ukuran File (GB):" GridPane.columnIndex="0"
                                            GridPane.rowIndex="5" />
                                        <TextField fx:id="dlcUkuranField" promptText="Contoh: 5.5"
                                            GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                        <Label text="Jenis:" GridPane.columnIndex="0"
                                            GridPane.rowIndex="6" />
                                        <TextField fx:id="dlcJenisField"
                                            promptText="Contoh: Ekspansi" GridPane.columnIndex="1"
                                            GridPane.rowIndex="6" />
                                    </children>
                                </GridPane>
                                <Button onAction="#handleSimpanDLC" styleClass="custom-button"
                                    text="Simpan DLC" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <right>
        <VBox prefWidth="420.0" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label styleClass="section-label" text="Produk Saya" />
                <TableView fx:id="produkTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colKode" prefWidth="70.0" text="Kode" />
                        <TableColumn fx:id="colJudul" prefWidth="200.0" text="Judul" />
                        <TableColumn fx:id="colTipe" prefWidth="50.0" text="Tipe" />
                        <TableColumn fx:id="colHarga" prefWidth="90.0" text="Harga" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </right>

    <bottom>
        <Label fx:id="lblStatus" text="" wrapText="true">
            <padding>
                <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
            </padding>
        </Label>
    </bottom>
</BorderPane>